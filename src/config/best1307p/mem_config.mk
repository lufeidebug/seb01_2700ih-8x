export FAST_XRAM_SECTION_SIZE ?= 0x1000

ifeq ($(VOICE_ASSIST_FF_FIR_LMS), 1)
export RAMCP_SIZE  := 242*1024
export RAMCPX_SIZE := 18*1024
else ifeq ($(SPEECH_TX_2MIC_NS4), 1)
export RAMCP_SIZE  := 220*1024
export RAMCPX_SIZE := 32*1024

else ifeq ($(SPEECH_TX_3MIC_NS), 1)
export RAMCP_SIZE  := 192*1024
export RAMCPX_SIZE := 39*1024
else ifeq ($(SPEECH_TX_3MIC_NS2), 1)
export RAMCP_SIZE  := 180*1024
export RAMCPX_SIZE := 32*1024
else
export RAMCP_SIZE  := 128*1024
export RAMCPX_SIZE := 64*1024
endif

ifeq ($(USE_BASIC_THREADS),1)
ifeq ($(ANC_APP),1)
BESBT_STACK_SIZE := 1024*4
else
BESBT_STACK_SIZE := 1024*3
endif
KBUILD_CPPFLAGS += -DAF_STACK_SIZE=1024*3
KBUILD_CPPFLAGS += -DAPP_THREAD_STACK_SIZE=1024*2
KBUILD_CPPFLAGS += -DINTERSYS_STACK_SIZE=1024
export OS_TIMER_THREAD_STACK_SIZE ?= 0x800
export OS_DYNAMIC_MEM_SIZE ?= 0x5000
endif

KBUILD_CPPFLAGS += -DFAST_XRAM_SECTION_SIZE=$(FAST_XRAM_SECTION_SIZE)
